ENVIRONMENT=production

DATABASE_URL=sqlite:////app/data/jobs.db

OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=120

MAX_UPLOAD_SIZE=5242880
MAX_RESUME_TEXT_LENGTH=200000
MAX_RESUME_PAGES=10

MAX_LLM_INPUT_LENGTH=12000
MAX_LLM_OUTPUT_LENGTH=12000

ALLOWED_CORS_ORIGINS=http://localhost:8501

ALLOWED_EXTERNAL_HOSTS=boards-api.greenhouse.io,api.lever.co,jobs.lever.co,boards.greenhouse.io

API_KEY=CHANGE_ME